---
// Original (vermilion) vs each replication (ultramarine), Pearson r with 95% CI, plus the pooled replication diamond.
import { fr } from '../lib/fmt';
interface Row { label: string; sub?: string; r: number; ci: [number, number] | null; tone?: string; legacy?: boolean }
interface Props { original?: { r: number; ci: [number, number] | null; label: string } | null; rows: Row[]; pooled?: { r: number; ci: [number, number]; pi?: [number, number] | null } | null }
const { original, rows, pooled } = Astro.props;

const W = 640, L = 210, R = 70, rowH = 24, top = 26;
const vals = [0, ...(original ? [original.r, ...(original.ci ?? [])] : []), ...rows.flatMap((r) => [r.r, ...(r.ci ?? [])]), ...(pooled ? pooled.ci : [])].filter((v) => isFinite(v));
let lo = Math.min(-0.1, ...vals), hi = Math.max(0.3, ...vals);
lo = Math.max(-1, Math.floor(lo * 10) / 10); hi = Math.min(1, Math.ceil(hi * 10) / 10);
const x = (v: number) => L + ((Math.max(lo, Math.min(hi, v)) - lo) / (hi - lo)) * (W - L - R);
const nRows = rows.length + (original ? 1 : 0) + (pooled ? 1.4 : 0);
const H = top + nRows * rowH + 26;
const ticks: number[] = [];
for (let t = Math.ceil(lo * 10) / 10; t <= hi + 1e-9; t += hi - lo > 0.9 ? 0.2 : 0.1) ticks.push(Math.round(t * 10) / 10);
const toneColor = (t?: string) => (t === 'failed' ? 'var(--bad)' : t === 'mixed' ? 'var(--mix)' : t === 'successful' ? 'var(--ok)' : 'var(--na)');
const trunc = (s: string, n = 30) => (s.length > n ? s.slice(0, n - 1) + '…' : s);
let y = top;
---
<figure class="fig">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Forest plot of original and replication effect sizes (Pearson r, 95% confidence intervals)">
    <text x={L} y="12">r (Pearson), 95% CI</text>
    {ticks.map((t) => (
      <g>
        <line x1={x(t)} x2={x(t)} y1={top - 6} y2={H - 20} stroke="var(--rule)" stroke-width={t === 0 ? 1.4 : 0.6} />
        <text x={x(t)} y={H - 6} text-anchor="middle">{fr(t, 1)}</text>
      </g>
    ))}
    {original && (
      <line x1={x(original.r)} x2={x(original.r)} y1={top - 6} y2={H - 20} stroke="var(--claim)" stroke-width="1" stroke-dasharray="3 3" opacity=".7" />
    )}
    {original && (() => { const yy = y + rowH / 2; y += rowH; return (
      <g>
        <text x="0" y={yy + 3.5} style="fill:var(--claim);font-weight:600">{trunc(original.label)}</text>
        {original.ci && <line x1={x(original.ci[0])} x2={x(original.ci[1])} y1={yy} y2={yy} stroke="var(--claim)" stroke-width="2" />}
        <rect x={x(original.r) - 5} y={yy - 5} width="10" height="10" fill="var(--claim)" transform={`rotate(45 ${x(original.r)} ${yy})`} />
        <text x={W - R + 8} y={yy + 3.5} style="fill:var(--claim)">{fr(original.r)}</text>
      </g>); })()}
    {rows.map((r) => { const yy = y + rowH / 2; y += rowH; const c = toneColor(r.tone); return (
      <g>
        <text x="0" y={yy + 3.5}>{trunc(r.label)}{r.legacy ? ' ·L' : ''}</text>
        {r.ci && <line x1={x(r.ci[0])} x2={x(r.ci[1])} y1={yy} y2={yy} stroke={c} stroke-width="1.6" />}
        <circle cx={x(r.r)} cy={yy} r="4.2" fill={c} />
        <text x={W - R + 8} y={yy + 3.5}>{fr(r.r)}</text>
      </g>); })}
    {pooled && (() => { const yy = y + rowH * 0.8; const [a, b] = pooled.ci; return (
      <g>
        <line x1="0" x2={W} y1={yy - rowH * 0.55} y2={yy - rowH * 0.55} stroke="var(--rule-2)" />
        <text x="0" y={yy + 3.5} style="fill:var(--obs);font-weight:600">Replications pooled</text>
        {pooled.pi && <line x1={x(pooled.pi[0])} x2={x(pooled.pi[1])} y1={yy} y2={yy} stroke="var(--obs)" stroke-width="1" stroke-dasharray="2 3" />}
        <polygon points={`${x(a)},${yy} ${x(pooled.r)},${yy - 6} ${x(b)},${yy} ${x(pooled.r)},${yy + 6}`} fill="var(--obs)" />
        <text x={W - R + 8} y={yy + 3.5} style="fill:var(--obs);font-weight:600">{fr(pooled.r)}</text>
      </g>); })()}
  </svg>
  <figcaption>
    Diamond in vermilion: the original claim. Dots: each replication, coloured by the authors' own verdict (blue replicated, ochre mixed, red not). Sites inside one paper are pooled first.
    {pooled?.pi && ' Dashed line: prediction interval — where a new replication would likely land.'}
    {rows.some((r) => r.legacy) && ' ·L = numbers from the legacy FReD file.'}
  </figcaption>
</figure>
