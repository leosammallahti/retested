---
// One mark per replication attempt: filled = replicated, crossed = did not, half = mixed, dotted = no verdict.
import { OUTCOME } from '../lib/fmt';
interface Props { outcomes: string[]; max?: number; label?: string }
const { outcomes, max = 28, label } = Astro.props;
const order = ['successful', 'mixed', 'failed', 'inconclusive', 'not_coded'];
const sorted = [...outcomes].sort((a, b) => order.indexOf(a) - order.indexOf(b));
const shown = sorted.slice(0, max);
const counts = Object.fromEntries(order.map((o) => [o, outcomes.filter((x) => x === o).length]));
const aria = label ?? order.filter((o) => counts[o]).map((o) => `${counts[o]} ${OUTCOME[o].label.toLowerCase()}`).join(', ');
---
<span class="tally" role="img" aria-label={aria || 'no attempts'} title={aria}>
  {shown.map((o) => (
    o === 'successful' ? (
      <svg viewBox="0 0 12 12" aria-hidden="true"><circle cx="6" cy="6" r="5" fill="var(--ok)" /></svg>
    ) : o === 'failed' ? (
      <svg viewBox="0 0 12 12" aria-hidden="true"><circle cx="6" cy="6" r="4.6" fill="none" stroke="var(--bad)" stroke-width="1.4" /><path d="M3.6 3.6l4.8 4.8M8.4 3.6l-4.8 4.8" stroke="var(--bad)" stroke-width="1.4" /></svg>
    ) : o === 'mixed' ? (
      <svg viewBox="0 0 12 12" aria-hidden="true"><circle cx="6" cy="6" r="4.6" fill="none" stroke="var(--mix)" stroke-width="1.4" /><path d="M6 1.4a4.6 4.6 0 0 1 0 9.2z" fill="var(--mix)" /></svg>
    ) : (
      <svg viewBox="0 0 12 12" aria-hidden="true"><circle cx="6" cy="6" r="4.6" fill="none" stroke="var(--na)" stroke-width="1.3" stroke-dasharray="1.6 1.6" /></svg>
    )
  ))}
  {outcomes.length > max && <span class="more">+{outcomes.length - max}</span>}
</span>
