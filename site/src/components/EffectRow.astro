---
import Stamp from './Stamp.astro';
import Tally from './Tally.astro';
import { u, fr, int } from '../lib/fmt';
import { effectLine, type EffectCard } from '../lib/data';
interface Props { e: EffectCard; showFame?: boolean }
const { e, showFame } = Astro.props;
const r = e.record;
const line = effectLine(e.slug);
const marks: string[] = [...Array(r.successful).fill('successful'), ...Array(r.mixed).fill('mixed'), ...Array(r.failed).fill('failed')];
---
<li>
  <a class="erow" href={u(`effect/${e.slug}/`)}>
    <span class="nm">{e.name}</span>
    <Stamp code={r.code} label={r.label} small />
    {line && <span class="dek">{line}</span>}
    <span class="meta">
      {e.discipline && <span>{e.discipline}</span>}
      {r.k > 0 && <span>{r.successful} replicated · {r.mixed} mixed · {r.failed} not</span>}
      {e.numeric?.ratio != null && <span>replications {fr(e.numeric.r)} vs original {fr(e.numeric.r_original)}</span>}
      {e.famous_status && r.k === 0 && <span>curated list: {e.famous_status.replace('_', ' ')}</span>}
      {showFame && e.fame > 0 && <span>{int(e.fame)} citations</span>}
      {marks.length > 0 && <Tally outcomes={marks} max={20} />}
    </span>
  </a>
</li>
