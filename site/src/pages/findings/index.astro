---
import Base from '../../layouts/Base.astro';
import { findings, papers } from '../../lib/data';
import { u } from '../../lib/fmt';

const allFindings = Object.values(findings());
const paperByDoi = papers();
const n = allFindings.length;
const initialFindings = allFindings
  .sort((a, b) => b.lenses.record.k - a.lenses.record.k || (paperByDoi[b.doi_o]?.year ?? 0) - (paperByDoi[a.doi_o]?.year ?? 0))
  .slice(0, 60);
---
<Base title="Original papers" description="Make a prediction, then inspect the source and attempt record for every original psychology paper in Retested." active="effects/">
  <div class="wrap" style="padding-top:2.4rem">
    <header class="rise">
      <div class="label">By paper</div>
      <h1>{n.toLocaleString()} original papers</h1>
      <p class="lede">Every original paper in Retested's finding record now has a local page. Open one, make a prediction, then reveal its source and attempt record. A record may contain one attempt, several mixed results, uncoded evidence, or no linked attempt yet; thin and unresolved records stay visible as exactly that.</p>
    </header>
    <div class="fbar"><input type="search" id="pq" placeholder="Title, author, year or DOI…" aria-label="Filter papers" /><span class="mono faint" id="pc" aria-live="polite">{n.toLocaleString()} papers</span></div>
    <ul class="rowlist" id="plist">
      {initialFindings.map((f) => {
        const paper = paperByDoi[f.doi_o];
        return <li><a class="erow" href={u(`finding/${f.slug}/`)}>
          <span class="nm">{paper?.title ?? f.doi_o}</span>
          <span class="chip">Guess the result →</span>
          <span class="meta"><span>{[paper?.authors, paper?.year].filter(Boolean).join(', ')}</span><span>prediction + source record</span></span>
        </a></li>;
      })}
    </ul>
    <noscript><p class="muted">Showing the 60 most-tested papers. Enable JavaScript to search the full index.</p></noscript>
    <p style="margin-top:1rem"><button class="btn ghost" id="more" hidden>Show more</button></p>
  </div>
</Base>
<script>
  import { u } from '../../lib/fmt';
  type E = { t: string; s: string; n: string; doi?: string; au?: string; y?: number; k: number };
  const q = document.getElementById('pq') as HTMLInputElement, list = document.getElementById('plist')!, more = document.getElementById('more')!;
  let all: E[] = [], shown = 60;
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  function render() {
    const qq = q.value.toLowerCase().trim();
    const hits = all.filter((e) => !qq || [e.n, e.au, e.y, e.doi].join(' ').toLowerCase().includes(qq));
    document.getElementById('pc')!.textContent = `${hits.length.toLocaleString()} papers`;
    list.innerHTML = hits.slice(0, shown).map((e) => {
      return `<li><a class="erow" href="${u('finding/' + e.s + '/')}"><span class="nm">${esc(e.n)}</span><span class="chip">Guess the result →</span><span class="meta"><span>${esc([e.au, e.y].filter(Boolean).join(', '))}</span><span>prediction + source record</span></span></a></li>`;
    }).join('');
    more.hidden = hits.length <= shown;
  }
  fetch(u('generated/search.json')).then((r) => r.json()).then((d: E[]) => {
    all = d.filter((e) => e.t === 'finding').sort((a, b) => b.k - a.k || (b.y ?? 0) - (a.y ?? 0));
    q.value = new URLSearchParams(location.search).get('q') ?? '';
    render();
  });
  q.addEventListener('input', () => { shown = 60; render(); });
  more.addEventListener('click', () => { shown += 120; render(); });
</script>
<style>
  .lede { font: 400 1.18rem/1.5 var(--f-display); color: var(--ink-2); }
  .fbar { display: flex; gap: .8rem; align-items: center; position: sticky; top: 0; background: var(--paper); padding: .8rem 0; border-bottom: 1px solid var(--ink); margin-top: 1.5rem; z-index: 5; }
  .fbar input { flex: 1; font: 400 .95rem var(--f-body); padding: .5rem .7rem; border: 1px solid var(--rule-2); border-radius: var(--r); background: var(--card); color: var(--ink); }
</style>
