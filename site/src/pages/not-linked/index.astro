---
// Effects named in FORRT's records with no replication of their own linked yet. They are not in the database: no list,
// count, map or search includes them. Each keeps its page and is listed here with the reason, so none is dropped.
import Base from '../../layouts/Base.astro';
import { unlinkedEffects, attempts, effects } from '../../lib/data';
import { u } from '../../lib/fmt';

const A = attempts();
const owned = new Set(effects().flatMap((e) => e.attempts));
const reason = (e: ReturnType<typeof unlinkedEffects>[number]) => {
  const unowned = e.shared_attempts.filter((id) => !owned.has(id));
  if (unowned.length) return 'Its original paper was retested, but the records do not say which of the paper’s claims the retest covered.';
  if (e.shared_attempts.length) return 'Replications of its original paper tested other claims from that paper, not this one.';
  if (e.originals.length) return 'FORRT names its original paper, but no replication of that paper.';
  return 'FORRT names it without any replication we could link yet.';
};
const rows = unlinkedEffects().map((e) => ({ e, why: reason(e) })).sort((a, b) => a.why.localeCompare(b.why) || a.e.name.localeCompare(b.e.name));
const groups = [...new Set(rows.map((r) => r.why))];
---
<Base title="Named, no replication linked" description="Effects named in FORRT's records that have no replication linked yet, and why." active="effects/" noindex>
  <article class="wrap" style="padding-top:2.4rem">
    <header class="rise">
      <div class="label"><a href={u('effects/')}>Effects</a></div>
      <h1>{rows.length} effects named, no replication linked yet</h1>
      <p class="lede">These effects are named in FORRT's records (its replication database or its Replications &amp; Reversals list), but no replication of them is linked here yet. They are not counted, listed or searchable in the database until one is. Each is listed under the reason.</p>
    </header>
    {groups.map((g) => (
      <section>
        <div class="sh"><h2>{g}</h2><span class="label">{rows.filter((r) => r.why === g).length}</span></div>
        <ul class="nl">
          {rows.filter((r) => r.why === g).map((r) => <li><a href={u(`effect/${r.e.slug}/`)}>{r.e.name}</a>{r.e.famous && <span class="faint"> · on FORRT's Replications &amp; Reversals list</span>}</li>)}
        </ul>
      </section>
    ))}
  </article>
</Base>
<style>
  .nl { columns: 2 22rem; padding-left: 1.1rem; }
  .nl li { margin-bottom: .3rem; break-inside: avoid; }
</style>
