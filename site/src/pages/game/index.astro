---
import Base from '../../layouts/Base.astro';
import Feed from '../../components/Feed.tsx';
import { u } from '../../lib/fmt';
---
<Base bare title="Did it replicate?" description="A phone feed of real psychology findings. Say whether each one replicated, then see what happened." active="game/">
  <h1 class="fsr">Did it replicate?</h1>
  <Feed client:load base={u('')} />
  <noscript>
    <div class="fstatus">
      <p>The feed reveals each result only after you answer, so it needs JavaScript.</p>
      <p>You can still browse <a href={u('effects/')}>effects</a> or <a href={u('findings/')}>papers</a>.</p>
    </div>
  </noscript>
</Base>
<style is:global>
  html:has(body.bare) { background: #000; }
  body.bare {
    --f-ink: #f4f1ea; --f-soft: #d9d5ca; --f-mute: #b4afa2; --f-faint: #8d887c; --f-line: #2e2e2a;
    --f-yes: #86a8ff; --f-no: #ff7b5f;
    background: #000; color: var(--f-ink); overflow: hidden;
  }
  .fsr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  .ftop { position: fixed; z-index: 5; top: 0; left: 50%; transform: translateX(-50%); width: min(100%, 30rem);
    display: flex; justify-content: space-between; align-items: center; pointer-events: none;
    padding: calc(.85rem + env(safe-area-inset-top)) 1.25rem 1.1rem; background: linear-gradient(#000 55%, rgba(0, 0, 0, 0)); }
  .ftop > * { pointer-events: auto; }
  .fbrand { font: 560 1.05rem/1 var(--f-display); letter-spacing: -.01em; color: var(--f-ink); text-decoration: none; }
  .fbrand:hover { color: var(--f-ink); }
  .ftally { font-size: .85rem; color: var(--f-mute); }

  .feed { position: fixed; inset: 0; overflow-x: hidden; overflow-y: auto; scroll-snap-type: y mandatory;
    overscroll-behavior: contain; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
  .feed::-webkit-scrollbar { display: none; }
  .fcard { display: flex; flex-direction: column; width: min(100%, 30rem); margin: 0 auto;
    min-height: 100vh; min-height: 100dvh; scroll-snap-align: start; scroll-snap-stop: always;
    padding: calc(3.6rem + env(safe-area-inset-top)) 1.25rem calc(1.25rem + env(safe-area-inset-bottom)); }
  @media (min-width: 31rem) { .fcard { border-inline: 1px solid #161614; } }

  .fbody { flex: 1; display: flex; flex-direction: column; justify-content: center; gap: 1.1rem; padding-block: 1rem; }
  .flabel { margin: 0; font-size: .72rem; letter-spacing: .08em; text-transform: uppercase; color: var(--f-faint); }
  .fname { margin: 0; font: 500 1.05rem/1.2 var(--f-display); color: var(--f-mute); }
  .fpart { display: flex; flex-direction: column; gap: .35rem; }
  .fkey { margin: 0; font-size: .7rem; letter-spacing: .08em; text-transform: uppercase; color: var(--f-faint); }
  .fstory { margin: 0; max-width: none; font: 400 1.18rem/1.55 var(--f-body); color: var(--f-soft); }
  .fclaim { margin: 0; max-width: none; font: 400 clamp(1.35rem, 5.6vw, 1.75rem)/1.28 var(--f-display); letter-spacing: -.01em; }
  .fmethod { margin: 0; max-width: none; font: 400 1.12rem/1.5 var(--f-body); color: var(--f-soft); }

  .fq { margin: 0 0 .7rem; max-width: none; font: 500 1.05rem/1.2 var(--f-display); color: var(--f-mute); }
  .fchoices { display: grid; grid-template-columns: 1fr 1fr; gap: .75rem; }
  .fbtn { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; min-height: 3.6rem; padding: .8rem 1rem;
    border: 1.5px solid #3b3b37; border-radius: 1rem; background: #0f0f0e; color: var(--f-ink); cursor: pointer;
    font: 560 1.15rem/1.1 var(--f-display); touch-action: manipulation; -webkit-tap-highlight-color: transparent;
    transition: transform .1s, background .15s, border-color .15s, opacity .15s; }
  .fbtn:active:not(:disabled) { transform: scale(.97); }
  .fbtn:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  .fbtn.yes span { color: var(--f-yes); }
  .fbtn.no span { color: var(--f-no); }
  .fbtn.yes:hover:not(:disabled) { border-color: var(--f-yes); }
  .fbtn.no:hover:not(:disabled) { border-color: var(--f-no); }
  .fbtn:disabled { cursor: default; }
  .fbtn:disabled:not(.picked) { opacity: .4; }
  .fbtn.picked.yes { background: var(--f-yes); border-color: var(--f-yes); color: #000; }
  .fbtn.picked.no { background: var(--f-no); border-color: var(--f-no); color: #000; }
  .fbtn.picked span { color: #000; }
  .fbtn.fgo { width: 100%; margin-top: 1rem; background: var(--f-ink); border-color: var(--f-ink); color: #000; }
  .ferr { margin: .8rem 0 0; font-size: .9rem; color: var(--f-no); }
  .fhint { margin: .9rem 0 0; text-align: center; font-size: .72rem; letter-spacing: .08em; text-transform: uppercase; color: var(--f-faint); }

  .fresult { animation: frise .25s ease both; }
  .fverdict-box:focus { outline: none; }
  .fverdict { display: flex; gap: .5rem; align-items: baseline; margin: 0 0 .5rem; max-width: none; font: 560 clamp(1.9rem, 8vw, 2.4rem)/1.1 var(--f-display); letter-spacing: -.01em; }
  .fverdict.yes { color: var(--f-yes); }
  .fverdict.no { color: var(--f-no); }
  .fgrade { display: inline-block; margin: 0 0 1.1rem; padding: .25rem .75rem; border: 1px solid #4a4a45; border-radius: 999px;
    font-size: .75rem; letter-spacing: .08em; text-transform: uppercase; color: var(--f-mute); }
  .fgrade.right { background: var(--f-ink); border-color: var(--f-ink); color: #000; }
  .frep { margin: 0 0 .9rem; }
  .frep figcaption { font-size: .75rem; color: var(--f-faint); }
  .frep blockquote { margin: .35rem 0 0; padding-left: .85rem; border-left: 2px solid var(--f-line); font: italic 400 1rem/1.45 var(--f-body); color: var(--f-ink); }
  .fcurated { margin: 0 0 .9rem; max-width: none; font-size: .92rem; color: var(--f-mute); }
  .fcurated b { color: var(--f-ink); }
  .flinks { display: flex; flex-direction: column; gap: .15rem; margin: 0; max-width: none; font-size: .85rem; line-height: 1.5; color: var(--f-faint); }
  .flinks a { align-self: flex-start; }
  .flinks a { color: var(--f-mute); text-decoration-color: #555; }
  .flinks a:hover { color: var(--f-ink); text-decoration-color: currentColor; }

  .fstatus { position: fixed; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .6rem;
    padding: 1.5rem; text-align: center; color: var(--f-mute); }
  .fstatus p { margin: 0; }
  .fstatus a { color: var(--f-ink); }
  .fstatus .fbtn.fgo { width: auto; margin-top: .6rem; padding-inline: 2rem; }

  /* small phones: keep a result and its Next button on one screen where possible */
  @media (max-height: 640px) {
    .fcard { padding-top: calc(3rem + env(safe-area-inset-top)); }
    .fbody { gap: .7rem; padding-block: .4rem; }
    .fclaim { font-size: 1.25rem; }
    .fmethod { font-size: 1rem; line-height: 1.45; }
    .fbtn { min-height: 3.25rem; }
    .fbtn.fgo { margin-top: .7rem; }
    .frep { margin-bottom: .6rem; }
    .frep blockquote { font-size: .92rem; line-height: 1.4; }
    .fverdict { font-size: 1.75rem; margin-bottom: .35rem; }
    .fgrade { margin-bottom: .7rem; }
    .fcard { padding-bottom: calc(.9rem + env(safe-area-inset-bottom)); }
  }

  @keyframes frise { from { opacity: 0; transform: translateY(8px); } }
  @media (prefers-reduced-motion: reduce) { .fresult { animation: none; } .fbtn { transition: none; } }
</style>
