---
import Base from '../../layouts/Base.astro';
import Dossier from '../../components/Dossier.astro';
import Pending from '../../components/Pending.astro';
import Story from '../../components/Story.astro';
import { effects, attempts, papers, findings, pending, storyFor, effectLine, type Effect } from '../../lib/data';
import { u, cleanQuote, clip, int, asClaim } from '../../lib/fmt';
import { typologyFor, STUDY_KIND, OUTCOME_KIND, WHO, SETTING } from '../../lib/typology';

export function getStaticPaths() {
  return effects().map((e) => ({ params: { slug: e.slug }, props: { e } }));
}
const { e } = Astro.props as { e: Effect };
const A = attempts();
const P = papers();
const F = findings();
const own = e.attempts.map((id) => A[id]);
const shared = e.shared_attempts.map((id) => A[id]);

const rowClaim = own.flatMap((a) => a.rows).find((r) => r.description && r.description.length > 30)?.description;
// curated effect-level wording first; a single study's claim only as a fallback
const claim = asClaim(e.famous?.description) ?? asClaim(e.description) ?? asClaim(rowClaim) ?? null;
// the plain sentence, read against its sources, says what the effect claims; the database's own wording is the fallback
const plain = effectLine(e.slug);
const ty = typologyFor(e.slug);
const verbatim = own.flatMap((a) => a.rows).find((r) => r.claim_text_o && r.claim_text_o.length > 30)?.claim_text_o ?? own.find((a) => a.retested_review?.original_claim_quote)?.retested_review?.original_claim_quote;
const orig = e.originals.map((d) => P[d]).filter(Boolean);
const byline = orig.length === 1 ? [orig[0].authors, orig[0].year].filter(Boolean).join(', ') : orig.length > 1 ? `${orig.length} original papers` : e.famous?.original_year ? `original from ${e.famous.original_year}` : '';
const fam = e.famous;
const famStatus = fam?.status ? { replicated: 'replicated', not_replicated: 'not replicated', mixed: 'mixed', reversed: 'reversed' }[fam.status] : null;
const findingPages = e.originals.map((d) => F[d]).filter(Boolean);
const P_ = pending();
const story = storyFor('effect', e.slug);
const unverified = P_.by_effect[e.id] ?? [];
const provisional = P_.effect_verdict_if_accepted[e.id] ?? null;
const linked = own.length > 0;
const desc = `${e.name}: ${e.lenses.record.label.toLowerCase()} — ${e.lenses.record.k} replication${e.lenses.record.k === 1 ? '' : 's'} with a verdict. ${plain ?? (claim ? clip(claim, 140) : '')}`;
---
<Base title={e.name} description={desc} active="effects/" noindex={!linked}>
  <article class="wrap">
    <header class="ehead rise">
      <div class="label"><a href={u('effects/')}>Effects</a>{e.discipline && <> / {e.discipline}</>}</div>
      <h1>{e.name}</h1>
      {byline && <p class="by mono">{byline}</p>}
      {(plain || claim) && (
        <div class="claimbox">
          <span class="label claim">The claim</span>
          <p class="ctext">{plain ?? clip(claim!, 360)}</p>
          {verbatim && verbatim !== claim && <p class="faint vb">In the original authors' words: “{clip(cleanQuote(verbatim), 260)}”</p>}
        </div>
      )}
      {e.aliases.length > 0 && <p class="faint al">Also filed as: {e.aliases.slice(0, 6).join(' · ')}</p>}
      {ty?.study_kind && STUDY_KIND[ty.study_kind] && (
        <p class="studytype">
          <span class="label">How the original study worked</span>
          <a class="tchip" href={u(`map/#${ty.study_kind}`)} title={STUDY_KIND[ty.study_kind].about}>{STUDY_KIND[ty.study_kind].name}</a>
          {ty.outcome_kind && OUTCOME_KIND[ty.outcome_kind] && <><span class="faint">measured as</span> <a class="tchip" href={u(`map/#${ty.outcome_kind}`)} title={OUTCOME_KIND[ty.outcome_kind].about}>{OUTCOME_KIND[ty.outcome_kind].name}</a></>}
          {ty.who_studied && ty.who_studied !== 'ADULTS' && WHO[ty.who_studied] && <span class="tchip quiet">{WHO[ty.who_studied]}</span>}
          {ty.setting && ty.setting !== 'NONE_OR_LAB' && SETTING[ty.setting] && <span class="tchip quiet">{SETTING[ty.setting]}</span>}
          {ty.body_brain_genes === 'YES' && <span class="tchip quiet">Measured in the body, brain, hormones or genes</span>}
        </p>
      )}
      {!linked && (
        <div class="notlinked">
          <b>No replication of this effect is linked yet.</b> It is named in FORRT's records, so it has a page, but it is not counted or listed in the database until a replication of it is linked.
          {shared.length > 0 ? ' Later studies of its original paper are shown below; the records do not say they tested this effect.' : ''}
          <a href={u('not-linked/')}>All such effects</a>
        </div>
      )}
    </header>

    {story ? (
      <>
        <Story story={story} mode="full" />
        <details class="fullrec">
          <summary>For researchers: the full record, with every number and source</summary>
          <Dossier attempts={own} lenses={e.lenses} originals={e.originals} shared={shared} subject="this effect" withAccounts={false} />
          {unverified.length > 0 && <Pending rows={unverified} subject="this effect" verdict={provisional} />}
        </details>
      </>
    ) : (
      <>
        <Dossier attempts={own} lenses={e.lenses} originals={e.originals} shared={shared} subject="this effect" />
        {unverified.length > 0 && <Pending rows={unverified} subject="this effect" verdict={provisional} />}
      </>
    )}

    {fam && (
      <section>
        <div class="sh"><h2>What the curated list said</h2><span class="label">FORRT Replications &amp; Reversals, 2021–22</span></div>
        <div class="card">
          <p>A hand-curated list of famous effects filed this one as <strong>{famStatus ?? 'not rated'}</strong>{fam.gs_citations ? <>; the original had about {int(fam.gs_citations)} Google Scholar citations when it was compiled</> : ''}. It is shown beside our computed record, never merged into it.</p>
          {fam.original_paper && <p class="muted" style="font-size:.95rem"><span class="label">Original</span><br />{clip(fam.original_paper.replace(/​/g, ''), 420)}</p>}
          {fam.critiques && <p class="muted" style="font-size:.95rem"><span class="label">Replications and critiques</span><br />{clip(fam.critiques.replace(/^Critiques?:\s*/i, '').replace(/​/g, ''), 700)}</p>}
          {(fam.original_es || fam.replication_es) && (
            <p class="muted mono" style="font-size:.78rem">{fam.original_es && <>Original effect size: {clip(fam.original_es.replace(/​/g, ''), 160)}<br /></>}{fam.replication_es && <>Replication effect sizes: {clip(fam.replication_es.replace(/​/g, ''), 260)}</>}</p>
          )}
        </div>
      </section>
    )}

    {findingPages.length > 0 && (
      <p class="faint" style="margin-top:2rem">Per-paper views: {findingPages.map((f, i) => <>{i > 0 && ' · '}<a href={u(`finding/${f.slug}/`)}>{P[f.doi_o]?.authors ?? f.doi_o}{P[f.doi_o]?.year ? ` ${P[f.doi_o].year}` : ''}</a></>)}</p>
    )}
    <p class="faint mono" style="font-size:.72rem;margin-top:2rem">Effect ID {e.id} · stable across renames</p>
  </article>
</Base>

<style>
  .ehead { padding-top: 2.4rem; }
  .ehead h1 { margin-top: .6rem; max-width: 22ch; }
  .by { color: var(--ink-2); font-size: .85rem; margin-top: -.6rem; }
  .claimbox { border-left: 4px solid var(--claim); padding: .3rem 0 .3rem 1.2rem; margin: 1.6rem 0 .6rem; max-width: 76ch; }
  .notlinked { margin: 1.2rem 0 .4rem; padding: .7rem 1rem; border: 1px solid var(--rule); border-left: 4px solid var(--ink-2); max-width: 76ch; font-size: .95rem; }
  .notlinked a { margin-left: .4rem; }
  .ctext { font: 400 clamp(1.15rem, 2vw, 1.4rem)/1.45 var(--f-display); margin: .3rem 0 0; }
  .vb { font-size: .92rem; margin-top: .6rem; font-style: italic; }
  .al { font-size: .9rem; }
  .studytype { display: flex; flex-wrap: wrap; gap: .4rem .5rem; align-items: center; margin: .9rem 0 0; font-size: .9rem; }
  .studytype .label { width: 100%; }
  .tchip { border: 1px solid var(--rule); border-radius: 999px; padding: .15rem .65rem; text-decoration: none; color: var(--ink); background: var(--paper-2); }
  a.tchip:hover { border-color: var(--ink-2); }
  .tchip.quiet { background: none; color: var(--ink-2); }
  .fullrec { margin-top: 3.5rem; border-top: 1px solid var(--ink); }
  .fullrec > summary { cursor: pointer; padding: 1rem 0; font: 500 .8rem/1.3 var(--f-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--ink-2); }
</style>
