---
// What FORRT has, what this site carries of it, and what Retested added: the summary of the FORRT ledger
// (data/build/forrt_ledger.json, one line per source row). Every build fails if any FORRT row has no outcome.
import Base from '../../layouts/Base.astro';
import { stats } from '../../lib/data';
import { u, int } from '../../lib/fmt';

const L = stats().forrt_ledger!;
const S = L.site;
const COLS: [string, string][] = [
  ['on the site', 'On the site'],
  ['on the site under another original', 'On the site, linked to a different original'],
  ['names an effect that has a replication', 'Names an effect that has a replication'],
  ['names an effect without a replication', 'Names an effect without a replication'],
  ['waiting to be read', 'In the queue, waiting to be read'],
  ['not yet read', 'Cited by FORRT, not yet read'],
  ['left out', 'Left out (reason below)'],
];
const files = Object.keys(L.by_file).filter((f) => !f.startsWith('Retested'));
const total = (f: string) => Object.values(L.by_file[f]).reduce((a, b) => a + b, 0);
const sum = (k: string) => files.reduce((a, f) => a + (L.by_file[f][k] ?? 0), 0);
const allRows = files.reduce((a, f) => a + total(f), 0);
---
<Base title="What FORRT has, and what this site carries" description="Every row of every FORRT file, and where it went on this site." active="methods/">
  <article class="wrap" style="padding-top:2.4rem">
    <header class="rise">
      <div class="label"><a href={u('methods/')}>Methods</a></div>
      <h1>What FORRT has, and what this site carries</h1>
      <p class="lede">Every row of every FORRT file this site reads, {int(allRows)} in all, has one recorded outcome below. A build that leaves any row without one stops and publishes nothing.</p>
    </header>

    <section>
      <div class="sh"><h2>In three numbers</h2></div>
      <ul class="dl">
        <li><b>{int(S.attempts)}</b> replication attempts are on the site: <b>{int(S.from_forrt)}</b> from FORRT's files and <b>{int(S.added_by_retested)}</b> added by Retested, each read against its source paper.</li>
        <li><b>{int(S.effects_with_replication)}</b> effects have at least one replication; <b>{int(S.effects_named_without_replication)}</b> more are named in FORRT's records without one and are <a href={u('not-linked/')}>listed apart</a>, not counted.</li>
        <li>Still to read: <b>{int(sum('waiting to be read') + (L.by_file['Retested finds (machine-found)']?.['waiting to be read'] ?? 0))}</b> machine-found papers in the <a href={u('queue/')}>queue</a> (from FORRT's extractor and from Retested's own search), and <b>{int(sum('not yet read'))}</b> rows of FORRT's Replications &amp; Reversals list that cite a later paper nobody has read yet: many are replications, others are reviews or commentaries.</li>
      </ul>
    </section>

    <section>
      <div class="sh"><h2>File by file</h2><span class="label">FORRT rows by outcome</span></div>
      <div class="table-wrap">
        <table class="led">
          <thead><tr><th>FORRT file</th><th>Rows</th>{COLS.map(([, l]) => <th>{l}</th>)}</tr></thead>
          <tbody>
            {files.map((f) => <tr><th scope="row">{f}</th><td>{int(total(f))}</td>{COLS.map(([k]) => <td>{L.by_file[f][k] ? int(L.by_file[f][k]) : <span class="faint">–</span>}</td>)}</tr>)}
          </tbody>
        </table>
      </div>
    </section>

    <section>
      <div class="sh"><h2>Why rows are left out or not yet read</h2></div>
      {files.filter((f) => L.reasons[f]).map((f) => (
        <div class="rs"><h3>{f}</h3><ul>{Object.entries(L.reasons[f]).map(([why, n]) => <li><b>{int(n)}</b> {why}</li>)}</ul></div>
      ))}
      <p class="faint">“On the site, linked to a different original” means the later paper is on the site, but FORRT's row names a different original paper for it than the one it is shown under. “Names an effect” rows carry no replication pair; they name an effect, and the effect's page holds whatever replications are linked to it.</p>
    </section>
  </article>
</Base>
<style>
  .table-wrap { overflow-x: auto; margin-top: 1rem; }
  .led { border-collapse: collapse; min-width: 60rem; font-size: .85rem; }
  .led th, .led td { border: 1px solid var(--rule); padding: .35rem .5rem; text-align: right; vertical-align: top; }
  .led th[scope=row], .led thead th:first-child { text-align: left; }
  .led thead th { font: 500 .72rem/1.3 var(--f-mono); color: var(--ink-2); }
  .rs h3 { margin: 1rem 0 .2rem; font-size: 1rem; }
  .rs ul { margin: 0; padding-left: 1.1rem; }
</style>
