---
import '../styles/global.css';
import Search from '../components/Search.tsx';
import { citation } from '../lib/data';
import { u, shortCitation } from '../lib/fmt';

interface Props { title: string; description?: string; active?: string; noindex?: boolean; canonicalPath?: string; bare?: boolean }
const { title, description = "Every psychology finding, tested again: an effect-by-effect guide to psychology's replication record, built on FORRT's open data.", active, noindex = false, canonicalPath, bare = false } = Astro.props;
const full = title === 'Retested' ? "Retested: psychology's findings, tested again" : `${title} · Retested`;
const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site ?? Astro.url).toString();
const nav = [
  ['effects/', 'Effects'],
  ['map/', 'What holds up'],
  ['findings/', 'Findings'],
  ['stats/', 'The record'],
  ['coverage/', 'Coverage'],
  ['uncounted/', 'The uncounted'],
  ['queue/', 'Review queue'],
  ['methods/', 'Methods'],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content={bare ? 'width=device-width, initial-scale=1, viewport-fit=cover' : 'width=device-width, initial-scale=1'} />
    {bare ? (
      <meta name="theme-color" content="#000000" />
    ) : (
      <>
        <meta name="theme-color" content="#f7f5ef" media="(prefers-color-scheme: light)" />
        <meta name="theme-color" content="#15140f" media="(prefers-color-scheme: dark)" />
      </>
    )}
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Retested" />
    <title>{full}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={u('favicon.svg')} type="image/svg+xml" />
    <link rel="manifest" href={u('manifest.webmanifest')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,300..700,0..100,0..1;1,9..144,300..700,0..100,0..1&family=IBM+Plex+Mono:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,300..700;1,6..72,300..700&display=swap" rel="stylesheet" />
    <script is:inline>
      try { const t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
    </script>
  </head>
  <body class={bare ? 'bare' : undefined}>
    {!bare && <header class="mast">
      <div class="wrap">
        <a class="brand" href={u('')}><b>Re<i>tested</i></b><span>psychology, tested again</span></a>
        <Search client:idle base={u('')} />
        <nav class="nav" aria-label="Main">
          <a class="play" href={u('game/')} aria-current={active === 'game/' ? 'page' : undefined}>▸ Play: did it replicate?</a>
          {nav.map(([href, label]) => <a href={u(href)} aria-current={active === href ? 'page' : undefined}>{label}</a>)}
        </nav>
      </div>
    </header>}
    <main>
      <slot />
    </main>
    {!bare && <footer class="foot">
      <div class="wrap grid grid-2">
        <div class="stack">
          <p><strong>Retested</strong> is an independent, effect-level explorer built on the open data of the <a href="https://forrt.org/replication-hub/">FORRT Replication Hub</a> (FReD and FLoRA). It is not an official FORRT product. The counted record also includes source-reviewed Retested additions. FORRT papers link to the <a href="https://forrt.org/flora-replication-atlas/">Replication Atlas</a>; every paper links to its primary source. Found a mistake or a missing replication? <a href="https://forrt.org/replication-hub/submit/">Submit it to FORRT</a>, so everyone benefits.</p>
          <p class="faint">FORRT data CC BY 4.0. Machine-found candidates still in the review queue are unverified. <a href={u('coverage/')}>See exactly what overlaps FORRT and what remains unresolved.</a></p>
        </div>
        <div>
          <div class="label">Please cite the data as</div>
          <p class="cite">{shortCitation(citation())} <a href={u('methods/#cite')}>Full author list</a>.</p>
          <p><button class="btn ghost" id="theme" type="button" style="padding:.5rem .7rem">Light / dark</button></p>
        </div>
      </div>
    </footer>}
    <script is:inline>
      document.getElementById('theme')?.addEventListener('click', () => {
        const r = document.documentElement;
        const dark = r.dataset.theme ? r.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        r.dataset.theme = dark ? 'light' : 'dark';
        try { localStorage.setItem('theme', r.dataset.theme); } catch (e) {}
      });
    </script>
  </body>
</html>
